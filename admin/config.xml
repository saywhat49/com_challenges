<?xml version="1.0" encoding="UTF-8"?>
<config>
	<fieldset
		name="general"
		label="COM_CHALLENGES_CONFIG_GENERAL_LABEL"
		>
		<field
			name="delete_data_on_uninstall"
			type="radio"
			label="COM_CHALLENGES_CONFIG_DELETE_DATA_LABEL"
			description="COM_CHALLENGES_CONFIG_DELETE_DATA_DESC"
			layout="joomla.form.field.radio.switcher"
			default="0"
			filter="integer"
			>
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>
	</fieldset>

	<fieldset
		name="references"
		label="COM_CHALLENGES_CONFIG_REFERENCES_LABEL"
		description="COM_CHALLENGES_CONFIG_REFERENCES_DESC"
		>
		<field
			name="ref_table_secteurs"
			type="text"
			label="COM_CHALLENGES_CONFIG_REF_TABLE_SECTEURS_LABEL"
			default="secteurs"
			filter="string"
			validate="regex"
			regex="^[A-Za-z0-9_]{1,64}$"
		/>
		<field
			name="ref_col_secteur_id"
			type="text"
			label="COM_CHALLENGES_CONFIG_REF_COL_SECTEUR_ID_LABEL"
			default="id"
			filter="string"
			validate="regex"
			regex="^[A-Za-z0-9_]{1,64}$"
		/>
		<field
			name="ref_col_secteur_code"
			type="text"
			label="COM_CHALLENGES_CONFIG_REF_COL_SECTEUR_CODE_LABEL"
			default="num_secteur"
			filter="string"
			validate="regex"
			regex="^[A-Za-z0-9_]{1,64}$"
		/>
		<field
			name="ref_col_secteur_libelle"
			type="text"
			label="COM_CHALLENGES_CONFIG_REF_COL_SECTEUR_LIBELLE_LABEL"
			default="libelle_secteur"
			filter="string"
			validate="regex"
			regex="^[A-Za-z0-9_]{1,64}$"
		/>
		<field
			name="ref_col_secteur_nom"
			type="text"
			label="COM_CHALLENGES_CONFIG_REF_COL_SECTEUR_NOM_LABEL"
			default="responsable_de_secteur"
			filter="string"
			validate="regex"
			regex="^[A-Za-z0-9_]{1,64}$"
		/>
		<field
			name="ref_col_secteur_email"
			type="text"
			label="COM_CHALLENGES_CONFIG_REF_COL_SECTEUR_EMAIL_LABEL"
			default="courriel_du_responsable"
			filter="string"
			validate="regex"
			regex="^[A-Za-z0-9_]{1,64}$"
		/>
		<field
			name="ref_col_secteur_email_adjoint"
			type="text"
			label="COM_CHALLENGES_CONFIG_REF_COL_SECTEUR_EMAIL_ADJOINT_LABEL"
			default="courriel_adjoint"
			filter="string"
			validate="regex"
			regex="^[A-Za-z0-9_]{1,64}$"
		/>
		<field
			name="ref_table_societes"
			type="text"
			label="COM_CHALLENGES_CONFIG_REF_TABLE_SOCIETES_LABEL"
			default="societes"
			filter="string"
			validate="regex"
			regex="^[A-Za-z0-9_]{1,64}$"
		/>
		<field
			name="ref_col_societe_nom"
			type="text"
			label="COM_CHALLENGES_CONFIG_REF_COL_SOCIETE_NOM_LABEL"
			default="societe"
			filter="string"
			validate="regex"
			regex="^[A-Za-z0-9_]{1,64}$"
		/>
		<field
			name="ref_col_societe_commune"
			type="text"
			label="COM_CHALLENGES_CONFIG_REF_COL_SOCIETE_COMMUNE_LABEL"
			default="commune"
			filter="string"
			validate="regex"
			regex="^[A-Za-z0-9_]{1,64}$"
		/>
		<field
			name="ref_col_societe_cp"
			type="text"
			label="COM_CHALLENGES_CONFIG_REF_COL_SOCIETE_CP_LABEL"
			default="cp"
			filter="string"
			validate="regex"
			regex="^[A-Za-z0-9_]{1,64}$"
		/>
		<field
			name="ref_col_societe_secteur"
			type="text"
			label="COM_CHALLENGES_CONFIG_REF_COL_SOCIETE_SECTEUR_LABEL"
			default="secteur"
			filter="string"
			validate="regex"
			regex="^[A-Za-z0-9_]{1,64}$"
		/>
		<field
			name="ref_col_societe_adhesion"
			type="text"
			label="COM_CHALLENGES_CONFIG_REF_COL_SOCIETE_ADHESION_LABEL"
			default="adhesion"
			filter="string"
			validate="regex"
			regex="^[A-Za-z0-9_]{1,64}$"
		/>
		<field
			name="ref_adhesion_value"
			type="text"
			label="COM_CHALLENGES_CONFIG_REF_ADHESION_VALUE_LABEL"
			default="Oui,1"
			filter="string"
		/>
	</fieldset>

	<fieldset
		name="permissions"
		label="JCONFIG_PERMISSIONS_LABEL"
		>
		<field
			name="rules"
			type="rules"
			label="JCONFIG_PERMISSIONS_LABEL"
			filter="rules"
			validate="rules"
			component="com_challenges"
			section="component"
		/>
	</fieldset>
</config>
